GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-3.8-flash
TIMEZONE=Asia/Dhaka

# Speech: languages tried for every spoken command (most confident result wins)
STT_LANGS=en-US,bn-BD
# Text-mode voice only (the window needs no wake word)
REQUIRE_WAKE_WORD=false
# Momo speaks every reply
VOICE_REPLY=true
# auto | edge | sapi | gtts   (python run.py --test-voice shows which one works)
VOICE_ENGINE=auto
VOICE_EN=en-GB-RyanNeural
VOICE_BN=bn-BD-NabanitaNeural

CONFIRM_BEFORE_SEND=true
HEADLESS=false

# Calling system
OWNER_NAME=Tuhin vai
# Audio output used to speak into calls. Empty = default speakers.
# With VB-Cable installed use: CABLE Input   (and choose "CABLE Output" as the call's microphone)
CALL_AUDIO_DEVICE=
CALL_ANSWER_TIMEOUT=45
CALL_FALLBACK_WAIT=15

# Where Momo saves documents, screenshots, code and data (must be inside your home folder)
# MOMO_WORKSPACE=C:\Users\YourName\Momo
